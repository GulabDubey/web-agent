# ------------------------------------------------------------------------------
# Companiesnext Customer Support Agent — environment configuration
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# All variables below are read exclusively through app/config/settings.py
# (pydantic-settings' Settings class), which loads this file itself - no
# `python-dotenv`/`load_dotenv()` call is needed anywhere else in the code.
# docker-compose.yml also loads `.env` directly via `env_file`.
# Never commit your real `.env` file.
# ------------------------------------------------------------------------------


# --- App server (run.py) -------------------------------------------------------
# All optional; defaults shown.
APP_ENV=development
HOST=0.0.0.0
PORT=8000
WORKERS=4


# --- Anthropic LLM (app/llm/anthropic.py) --------------------------------------
# Used by ChatService to generate chat replies.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4


# --- MySQL database (app/config/database.py) -----------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=web_agent


# --- Qdrant vector store (app/core/qdrant.py) -----------------------------------
# Stores website content embeddings used to answer chat questions.
# Matches the "qdrant" service in docker-compose.yml.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=companiesnext


# --- Embeddings (app/services/embedding_service.py) ----------------------------
# Query embeddings come from the Hugging Face Inference API using
# BAAI/bge-large-en-v1.5 (the same model used to build the Qdrant collections
# locally). Requires a token with "Make calls to Inference Providers" permission.
HF_TOKEN=your-huggingface-token

# VOYAGE_API_KEY is required by app/config/settings.py but currently unused.
VOYAGE_API_KEY=your-voyage-api-key


# --- Django subscription verification (app/services/subscription_service.py) --
# Server-to-server only - never exposed to the browser.
# DJANGO_SERVICE_API_KEY must equal one entry of the Django project's
# CHATBOT_SERVICE_TOKENS. The URL must be https:// unless APP_ENV=development.
DJANGO_SUBSCRIPTION_VERIFY_URL=https://django.example.com/api/internal/chatbot/verify-subscription/
DJANGO_SERVICE_API_KEY=
DJANGO_VERIFY_TIMEOUT_SECONDS=5
# Stop calling Django for COOLDOWN seconds after THRESHOLD failures in a minute.
DJANGO_VERIFY_FAILURE_THRESHOLD=5
DJANGO_VERIFY_COOLDOWN_SECONDS=30


# --- Django database, read-only (app/services/site_collection_service.py) -----
# Every chat reads websites_website.collection_name for the verified site.
# Empty host/user/password fall back to DB_HOST / DB_USER / DB_PASSWORD.
# A read-only MySQL user is recommended.
DJANGO_DB_NAME=django_app
DJANGO_DB_HOST=
DJANGO_DB_PORT=3306
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=


# --- Widget access tokens (app/services/widget_token_service.py) --------------
# At least 32 random characters, different from every service credential:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WIDGET_JWT_SECRET=
WIDGET_TOKEN_TTL_SECONDS=600
# How long after expiry a token may still be exchanged for a new one.
WIDGET_TOKEN_REFRESH_GRACE_SECONDS=1800


# --- Widget authorization (app/core/widget_auth.py) ---------------------------
# Seconds a Django "authorized" answer / a denial is reused before re-checking.
WIDGET_AUTH_CACHE_TTL_SECONDS=60
WIDGET_DENY_CACHE_TTL_SECONDS=30
# Optional extra allowlist of domains (comma-separated). Empty = only the
# domain registered for the site key in Django.
WIDGET_ALLOWED_ORIGINS=
# Development only (APP_ENV=development): localhost / 127.0.0.1 pages are
# verified with Django as this registered domain.
WIDGET_DEV_DOMAIN=
WIDGET_MAX_MESSAGE_CHARS=2000


# --- Rate limits & usage (Redis-backed; per minute unless noted) --------------
RATE_LIMIT_INVALID_KEY_PER_IP=10
RATE_LIMIT_SESSIONS_PER_IP=20
RATE_LIMIT_SESSIONS_PER_SITE=300
RATE_LIMIT_CHAT_PER_SESSION=15
RATE_LIMIT_CHAT_PER_IP=40
RATE_LIMIT_CHAT_PER_SITE=300
WIDGET_MAX_CONCURRENT_PER_SITE=10
# LLM tokens per site per UTC day; 0 disables the cap.
WIDGET_DAILY_TOKEN_LIMIT_PER_SITE=1000000


# --- Internal service endpoints ------------------------------------------------
# Bearer tokens (comma-separated, for rotation) required by /users and
# /internal/widget/invalidate.
INTERNAL_SERVICE_TOKENS=
