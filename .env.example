# ------------------------------------------------------------------------------
# Companiesnext Customer Support Agent — environment configuration
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# All variables below are read exclusively through app/config/settings.py
# (pydantic-settings' Settings class), which loads this file itself - no
# `python-dotenv`/`load_dotenv()` call is needed anywhere else in the code.
# docker-compose.yml also loads `.env` directly via `env_file`.
# Never commit your real `.env` file.
# ------------------------------------------------------------------------------


# --- App server (run.py) -------------------------------------------------------
# All optional; defaults shown.
APP_ENV=development
HOST=0.0.0.0
PORT=8000
WORKERS=4


# --- Anthropic LLM (app/llm/anthropic.py) --------------------------------------
# Used by ChatService to generate chat replies.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4


# --- MySQL database (app/config/database.py) -----------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=web_agent


# --- Redis (app/config/redis.py, app/services/redis_service.py) ---------------
# Used to store per-session chat history (short TTL). Optional; defaults shown.
REDIS_HOST=localhost
REDIS_PORT=6379


# --- Qdrant vector store (app/core/qdrant.py) -----------------------------------
# Stores website content embeddings used to answer chat questions.
# Matches the "qdrant" service in docker-compose.yml.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=companiesnext


# --- Embeddings (app/services/embedding_service.py) ----------------------------
# HF_TOKEN authenticates downloading the BAAI/bge-large-en-v1.5 model from
# Hugging Face Hub.
HF_TOKEN=your-huggingface-token

# VOYAGE_API_KEY is required by app/config/settings.py even though embeddings
# currently run locally via sentence-transformers rather than the Voyage API.
VOYAGE_API_KEY=your-voyage-api-key
